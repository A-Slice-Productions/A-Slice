<?xml version="1.0" encoding="utf-8"?>
<project
xmlns="http://lime.openfl.org/project/1.0.4"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://lime.openfl.org/xsd/project-1.0.4.xsd">

	<!-- ================= App ================= -->
	<app title="Friday Night Funkin': H-Slice+JS (HRK Engine Redux)"
		file="H-Slice+JS"
		packageName="com.hrek.hexex.hslice"
		main="Main"
		version="0.2"
		company="hrek-hexex" />

	<set name="APP_ID" value="0x0100f6c013bbc000" />
	<meta build-number="331"/>

	<!-- ================= IMPORTANT FIXES ================= -->

	<!-- ❌ REMOVE GPU race condition crash source -->
	<!-- MULTITHREADED_LOADING is unstable on NVIDIA + Wayland -->
	<!-- <define name="MULTITHREADED_LOADING" if="cpp" /> -->

	<!-- ❌ Keep GC safer (prevents spikes during caching) -->
	<haxedef name="HXCPP_GC_GENERATIONAL" if="cpp" />

	<!-- ❌ Prevent large allocation spikes during preload -->
	<!-- REMOVE BIG BLOCKS -->
	<!-- <haxedef name="HXCPP_GC_BIG_BLOCKS" if="cpp" /> -->

	<!-- ================= Preloader ================= -->
	<app preloader="mikolka.vslice.FunkinPreloader" />

	<!-- ================= Core defines ================= -->
	<define name="MODS_ALLOWED" if="desktop || mobile" />
	<define name="HSCRIPT_ALLOWED" if="desktop || mobile"/>
	<define name="LUA_ALLOWED" if="cpp" />

	<define name="DISCORD_ALLOWED" if="desktop" unless="hl"/>
	<define name="BASE_GAME_FILES" unless="NO_BASEGAME_FILES" />

	<!-- ❌ Safer loading behavior -->
	<define name="SHOW_LOADING_SCREEN" />
	<define name="STRICT_LOADING_SCREEN" />

	<!-- ❌ Disable optional unstable features -->
	<!-- REMOVE THIS (can break GPU pipelines on Linux) -->
	<!-- <define name="MULTITHREADED_LOADING" if="cpp" /> -->

	<!-- ================= DEBUG SAFETY ================= -->
	<section if="debug">
		<define name="OPENFL_LOOKUP" />
		<define name="NATIVE_LOOKUP" />
	</section>

	<!-- ================= WINDOW ================= -->
	<window width="1280" height="720" background="#000000"
		hardware="true"
		vsync="false"
		allow-high-dpi="true"/>

	<!-- ================= LINUX FIX (IMPORTANT) ================= -->
	<!-- Helps avoid Wayland OpenGL instability -->
	<section if="linux">
		<haxedef name="HXCPP_CHECK_POINTER" />
		<haxedef name="HXCPP_STACK_TRACE" />
		<haxedef name="HXCPP_CATCH_SEGV" />
	</section>

	<!-- ================= Assets (unchanged but safe) ================= -->
	<classpath name="source" />

	<assets path="assets/fonts" />
	<assets path="assets/shared" />
	<assets path="assets/week_assets" rename="assets" />

	<!-- ================= Libraries ================= -->
	<haxelib name="flixel"/>
	<haxelib name="flixel-addons" version="3.3.2"/>
	<haxelib name="hxcpp"/>
	<haxelib name="tjson" version="1.4.0"/>

	<haxelib name="linc_luajit" if="LUA_ALLOWED"/>
	<haxelib name="hscript-iris" if="HSCRIPT_ALLOWED" version="1.1.3"/>

	<section if="linux">
		<haxelib name="hxCodec"/>
	</section>

	<haxelib name="flxanimate"/>

	<!-- ================= Safety flags ================= -->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	<haxedef name="HXCPP_CPP11" if="cpp" />
	<haxedef name="lime_disable_assets_version" />
	<haxedef name="no-deprecation-warnings" />

</project>
